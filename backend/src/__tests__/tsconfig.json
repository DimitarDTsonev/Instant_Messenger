{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleDetection": "force",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "types": ["node", "jest"]
  },
  "include": ["./**/*.ts", "../**/*.ts"]
}
