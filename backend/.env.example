# Copy this file to .env for local development
# Set these as environment variables on Render for production

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=https://your-username.github.io

# Email — password reset (https://resend.com, free tier: 3,000 emails/month)
# Without these set, reset links are only printed to the server logs.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev   # use your verified domain in production

# Music Dashboard bot account (auto-created on first startup if these are set)
# Password must: be 6+ chars, have uppercase, a digit, and a special character
BOT_USERNAME=MusicBot
BOT_EMAIL=musicbot@dashboard.local
BOT_PASSWORD=MusicBot1!