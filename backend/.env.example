# Copy this file to .env for local development
# Set these as environment variables on Render for production

PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_URL=https://your-username.github.io

# Music Dashboard bot account (auto-created on first startup if these are set)
# Password must: be 6+ chars, have uppercase, a digit, and a special character
BOT_USERNAME=MusicBot
BOT_EMAIL=musicbot@dashboard.local
BOT_PASSWORD=MusicBot1!